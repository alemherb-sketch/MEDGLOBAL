# Plantilla de configuracion para la app de escritorio.
# Copiar a backend/.env antes de empaquetar (ese archivo no se versiona).

# Servidor central (VPS) — mismos endpoints /sync ya desplegados
SYNC_SERVER_URL=https://api.medglobal.erpgest.com.pe
SYNC_USERNAME=
SYNC_PASSWORD=

# Opcional: panel remoto de licencias (desktop/admin_licencias)
# MEDGLOBAL_LICENCIAS_URL=http://127.0.0.1:8010

# Puerto local del servidor embebido
# MEDGLOBAL_PORT=8000
