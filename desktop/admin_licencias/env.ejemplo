# Administrador de licencias MEDGLOBAL (remoto)
# Este servicio NO es la app web: vive aparte y guarda la clave privada.

# Token largo y aleatorio (obligatorio para el panel)
LICENCIAS_ADMIN_TOKEN=cambie-este-token-por-uno-largo

# Claves (generadas con backend/generar_claves_licencia.py)
# La PRIVADA solo aqui. La PUBLICA es la misma que lleva el .exe de escritorio.
LICENCIA_PRIVADA=C:\ruta\segura\licencia_privada.pem
LICENCIA_PUBLICA=C:\ruta\segura\licencia_publica.pem

# Base de emitidas y activaciones
# LICENCIAS_DB=licencias_admin.db

# Puerto
# PORT=8010
