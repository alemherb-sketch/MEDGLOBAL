# Paquetes del instalable de escritorio: son artefactos de build de ~130 MB
# que se regeneran con `cd frontend && VITE_API_URL='' npm run build` y
# `cd backend && python setup.py build`. Ademas la carpeta armada incluye el
# .env con la contrasena de sincronizacion y una medglobal.db con datos de
# pacientes: nada de eso va al repositorio.
# El comodin cubre tambien las carpetas con version (…_v1.3/): sin el, un
# `git add -A` subia el .env con la contrasena y la base con datos de
# pacientes de cada paquete armado.
MEDGLOBAL_Instalador_Offline*/
MEDGLOBAL_Instalador_Offline*.zip
MEDGLOBAL_Instalador_Offline*.rar
desktop/admin_licencias/*.db
desktop/admin_licencias/licencia_privada.pem
.DS_Store
.deploy_last_commit

# Respaldos de la migracion al VPS: volcados COMPLETOS de la base de
# produccion (datos de pacientes), el .env con la contrasena de PostgreSQL y
# los roles con sus hashes SCRAM. El repositorio es PUBLICO: un `git add -A`
# sin esta regla los publicaba.
RESPALDOS-MIGRACION/
# Instrucciones para emitir licencias (procedimiento con la clave privada).
